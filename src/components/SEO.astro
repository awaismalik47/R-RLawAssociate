---
/**
 * Head tags: title, description, canonical, hreflang, Open Graph, Twitter Card and JSON-LD.
 * Title (50–60 chars) and description (140–155 chars) are required and validated at build time
 * for English pages, so a page cannot ship with missing or out-of-range metadata.
 */
import { SITE, abs } from '../data/site';
import { URDU_PAIRS, enFor, type Lang } from '../lib/i18n';

export interface SEOProps {
  title: string;
  description: string;
  lang?: Lang;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}
type Props = SEOProps;

const { title, description, lang = 'en', image = SITE.ogImage, imageAlt, type = 'website', jsonLd = [], noindex = false, published, modified } = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const strict = lang === 'en';
const [tMin, tMax, dMin, dMax] = strict ? [50, 60, 140, 155] : [25, 70, 70, 160];
if (!title || title.length < tMin || title.length > tMax) {
  throw new Error(`SEO: title for ${path} is ${title?.length ?? 0} chars (needs ${tMin}–${tMax}): "${title}"`);
}
if (!description || description.length < dMin || description.length > dMax) {
  throw new Error(`SEO: description for ${path} is ${description?.length ?? 0} chars (needs ${dMin}–${dMax}): "${description}"`);
}

const canonical = abs(path);
// hreflang: pair English ↔ Urdu where an Urdu version exists.
let enPath: string | undefined;
let urPath: string | undefined;
if (lang === 'ur') { urPath = path; enPath = enFor(path); }
else { enPath = path; urPath = URDU_PAIRS[path]; }
const ogImage = abs(image);
const graph = jsonLd.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c') : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{!noindex && enPath && <link rel="alternate" hreflang="en" href={abs(enPath)} />}
{!noindex && urPath && <link rel="alternate" hreflang="ur" href={abs(urPath)} />}
{!noindex && enPath && <link rel="alternate" hreflang="x-default" href={abs(enPath)} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={lang === 'ur' ? 'ur_PK' : 'en_PK'} />
{urPath && enPath && <meta property="og:locale:alternate" content={lang === 'ur' ? 'en_PK' : 'ur_PK'} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{image === SITE.ogImage && <meta property="og:image:width" content="1200" />}
{image === SITE.ogImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt ?? `${SITE.name} — advocates near Lahore High Court, Mozang Chungi, Lahore`} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{graph && <script type="application/ld+json" set:html={graph} />}
