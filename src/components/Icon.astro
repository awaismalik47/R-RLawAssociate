let svg: string;
let viewBox: string;
let attrs: Record<string, string>;
if (LINE[name]) {
  svg = LINE[name]; viewBox = '0 0 48 48';
  attrs = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.25', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
} else if (UI[name]) {
  svg = UI[name]; viewBox = '0 0 24 24';
  attrs = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
} else if (FILL[name]) {
  svg = FILL[name]; viewBox = name === 'whatsapp' ? '0 0 32 32' : '0 0 24 24';
  attrs = { fill: 'currentColor' };
} else {
  throw new Error(`Unknown icon: ${name}`);
}
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} class={cls} {...attrs} aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined} focusable="false"><Fragment set:html={(title ? `<title>${title}</title>` : '') + svg} /></svg>
