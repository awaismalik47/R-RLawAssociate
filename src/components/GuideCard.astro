---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../lib/i18n';
interface Props { href: string; title: string; excerpt: string; image: ImageMetadata; imageAlt: string; updated: Date; headingTag?: 'h2' | 'h3' }
const { href, title, excerpt, image, imageAlt, updated, headingTag = 'h3' } = Astro.props;
const H = headingTag;
---
<article class="media-card reveal">
  <div class="media-card__img">
    <Image src={image} alt={imageAlt} widths={[360, 560, 760]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw" loading="lazy" />
  </div>
  <div class="media-card__body">
    <p class="media-card__meta">Updated <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time></p>
    <H><a class="card__link" href={href}>{title}</a></H>
    <p>{excerpt}</p>
    <span class="text-link" aria-hidden="true">Read the guide</span>
  </div>
</article>
