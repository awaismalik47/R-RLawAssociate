---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import PillarDivider from '../components/PillarDivider.astro';
import { SITE } from '../data/site';
import chamberImg from '../assets/images/rr-law-associates-advocates-chamber-lahore.jpg';
import monogramImg from '../assets/images/rr-law-associates-chamber-gold-monogram.jpg';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About the Firm', href: '/about/' },
];
const values = [
  { t: 'Plain language', d: 'We explain the law, the options and the risks in words you can follow, in English, Urdu or Punjabi. Where a legal term is unavoidable, we tell you what it means.' },
  { t: 'Fees in writing', d: 'Before you instruct us, we explain what the fee covers and what it does not, and we confirm it in writing. There are no surprises at the end of a hearing.' },
  { t: 'Regular updates', d: 'After each hearing we tell you what happened, what the next date is and whether anything is needed from you, by phone, WhatsApp or email.' },
  { t: 'Confidentiality', d: 'What you tell us stays within the firm. We take particular care with family and criminal matters, where privacy matters most.' },
];
---
<BaseLayout
  title="About Our Law Firm in Mozang Chungi | R&R Law Associates"
  description="About R&R Law Associates (Raza & Raza Law Associates), a law firm in Mozang Chungi, Lahore, near the High Court: how we work and what we stand for."
  breadcrumbs={crumbs}
>
  <PageHero
    title="About R&R Law Associates"
    eyebrow="About the firm"
    intro="R&R Law Associates, whose full name is Raza & Raza Law Associates, is a firm of advocates practising from Siddiqi Plaza on Turner Road, Mozang Chungi, close to the Lahore High Court."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2>A Lahore chamber built around litigation</h2>
        <span class="rule"></span>
        <p>Our work is mainly court work: family cases, bail and criminal trials, civil and property suits, constitutional petitions and service appeals, together with advisory work for businesses. Our location on Turner Road puts the Lahore High Court, the district courts and many government offices within easy reach, which helps when a matter is urgent.</p>
        <p>The firm was founded by <span class="placeholder">[PLACEHOLDER: founding advocates and year established]</span>. Today our advocates appear before <span class="placeholder">[PLACEHOLDER: confirm courts, e.g. the Lahore High Court and the district courts of Lahore]</span>.</p>
        <p>Clients come to us from across Lahore, from Mozang, Anarkali and Lower Mall to Gulberg, Model Town, Johar Town and DHA, and from other districts of Punjab. Many of our clients live overseas and instruct us through a power of attorney.</p>
      </div>
      <div class="frame-wrap reveal">
        <div class="frame">
          <Image src={chamberImg} alt="Wood-panelled advocates' chamber of R&R Law Associates on Turner Road, Mozang Chungi, Lahore" widths={[480, 760, 1000]} sizes="(min-width: 900px) 560px, 92vw" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--stone">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>What you can expect from us</h2>
        <span class="rule"></span>
      </div>
      <div class="grid grid--4">
        {values.map((v) => (
          <div class="card reveal"><h3>{v.t}</h3><p>{v.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="frame-wrap reveal">
        <div class="frame">
          <Image src={monogramImg} alt="Gold R&R monogram in the chamber of R&R Law Associates, Lahore" widths={[480, 760, 1000]} sizes="(min-width: 900px) 560px, 92vw" loading="lazy" />
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow">Professional standards</p>
        <h2>Information, not promotion</h2>
        <span class="rule"></span>
        <p>As advocates we are bound by the Legal Practitioners and Bar Councils Act 1973 and the rules of the Pakistan Bar Council. That is why this website describes what we do and how the law works, but does not publish client testimonials, ratings, case results or comparisons with other firms.</p>
        <p>No advocate can promise the outcome of a case. What we can promise is careful preparation, honest advice about your prospects and regular communication. Read our <a href="/disclaimer/">disclaimer and privacy notice</a> for more about how this website should be used.</p>
      </div>
    </div>
  </section>

  <section class="section section--stone">
    <div class="container container--narrow center">
      <PillarDivider />
      <h2 class="mt-2">Find out more</h2>
      <p>Meet <a href="/advocates/">our advocates</a>, see <a href="/practice-areas/">the areas of law we practise</a>, or read about <a href="/process/">how a matter proceeds and how fees are explained</a>.</p>
      <p>Our office: {SITE.name}, {SITE.napAddress}.</p>
    </div>
  </section>

  <CTASection />
</BaseLayout>
